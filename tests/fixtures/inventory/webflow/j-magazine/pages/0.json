crossorigin=\"anonymous\"></script><script src=\"https://cdn.prod.website-files.com/643eb5ed8b2d3374948f6451/js/webflow.94b339a6.3860077135fd0abd.js\" type=\"text/javascript\" integrity=\"sha384-pa1V0QdBMGlcpkNVwCMOdMWwYdvGz7RJren02Qss7bULt+tjz/nu20/05IaHtfb+\" crossorigin=\"anonymous\"></script><!-- Lenis (smooth scrolling) -->\n<script src=\"https://cdn.jsdelivr.net/npm/@studio-freight/lenis@1.0.42/dist/lenis.min.js\"></script>\n\n<script>\n  (function () {\n    \"use strict\";\n\n    // Respect Reduced Motion\n    var prefersReducedMotion =\n      window.matchMedia && window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n    if (prefersReducedMotion) return;\n\n    window.Webflow = window.Webflow || [];\n    window.Webflow.push(function () {\n      if (!window.Lenis) return;\n\n      // ---- SHOWREEL: STABILITY-FIRST SETTINGS ----\n      var lenis = new Lenis({\n        // Floaty but stable\n        duration: 2.0,\n\n        // Smooth ease-out (no harsh snap)\n        easing: function (t) {\n          return t === 1 ? 1 : 1 - Math.pow(2, -10 * t);\n        },\n\n        smoothWheel: true,\n        smoothTouch: false,\n\n        // Lower multipliers reduce “spiky” deltas from some mice/trackpads\n        wheelMultiplier: 0.8,\n        touchMultiplier: 1.0,\n\n        // Helps normalize some wheel/trackpad deltas\n        normalizeWheel: true,\n\n        // Caps the internal interpolation to reduce micro-stutter on some machines\n        // (If this feels laggy, set to 120 or remove)\n        syncTouch: false\n      });\n\n      window.__LENIS__ = lenis;\n\n      // Anchor links (#section)\n      document.addEventListener(\n        \"click\",\n        function (e) {\n          var link = e.target.closest('a[href^=\"#\"]');\n          if (!link) return;\n\n          var id = link.getAttribute(\"href\");\n          if (!id || id === \"#\") return;\n\n          var target = document.querySelector(id);\n          if (!target) return;\n\n          e.preventDefault();\n          lenis.scrollTo(target, { offset: 0, immediate: false });\n        },\n        true\n      );\n\n      // ---- Drive Lenis ONLY ONCE ----\n      // Prefer GSAP ticker if GSAP exists, otherwise rAF.\n      // Also cap ticker fps to reduce jitter during recording.\n      if (window.gsap) {\n        // Cap GSAP ticker FPS for super consistent motion in screen recordings\n        // 60 is most stable; try 120 if your machine can hold it.\n        window.gsap.ticker.fps(60);\n\n        // Keep ScrollTrigger in sync if present\n        if (window.ScrollTrigger) {\n          lenis.on(\"scroll\", window.ScrollTrigger.update);\n          window.ScrollTrigger.refresh();\n        }\n\n        window.gsap.ticker.add(function (time) {\n          lenis.raf(time * 1000); // seconds -> ms\n        });\n\n        window.gsap.ticker.lagSmoothing(0);\n      } else {\n        function raf(time) {\n          lenis.raf(time);\n          requestAnimationFrame(raf);\n        }\n        requestAnimationFrame(raf);\n      }\n\n      // ---- Optional: prevent “layout shift” refresh jitter ----\n      // If you have lots of images loading in, refresh ScrollTrigger after everything is loaded.\n      window.addEventListener(\"load\", function () {\n        if (window.ScrollTrigger) window.ScrollTrigger.refresh();\n      });\n    });\n  })();\n</script>\n\n\n</body></html>"
